{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Burrow · Hand-drawn Minimal",
  "version": "1.0.0",
  "color": {
    "paper":        { "$type": "color", "$value": "#FFFFFF", "$description": "Page background. No cards: content sits straight on the paper." },
    "ink":          { "$type": "color", "$value": "#1A1A1A", "$description": "Text, doodles, primary buttons." },
    "pencil":       { "$type": "color", "$value": "#6B6B6B", "$description": "Secondary text and meta lines." },
    "graphite":     { "$type": "color", "$value": "#A3A3A3", "$description": "Disabled text, faded photos, placeholder text." },
    "rule":         { "$type": "color", "$value": "#1A1A1A26", "$description": "Sketchy hairline dividers (ink at 15%)." },
    "smudge":       { "$type": "color", "$value": "#F4F3EF", "$description": "The only fill: input wells, photo placeholders, the mask box." },
    "marker":       { "$type": "color", "$value": "#FFE45C", "$description": "The one accent. A highlighter swipe behind one key word or number per screen." },
    "markerInk":    { "$type": "color", "$value": "#1A1A1A", "$description": "Text on marker; always ink, in both themes." },
    "redPen":       { "$type": "color", "$value": "#DC2626", "$description": "Hand-drawn crosses and warnings for private or destructive states only." },
    "dark": {
      "paper":  { "$type": "color", "$value": "#141414" },
      "ink":    { "$type": "color", "$value": "#F2F0EA" },
      "pencil": { "$type": "color", "$value": "#A8A6A0" },
      "graphite": { "$type": "color", "$value": "#6E6C67" },
      "rule":   { "$type": "color", "$value": "#F2F0EA26" },
      "smudge": { "$type": "color", "$value": "#1F1F1E" },
      "marker": { "$type": "color", "$value": "#FFE45C" },
      "redPen": { "$type": "color", "$value": "#F87171" }
    }
  },
  "font": {
    "hand": { "$type": "fontFamily", "$value": ["Caveat", "cursive"], "$description": "Hand-lettering: headlines, big numbers, doors, buttons, nav. Weights 400/600/700." },
    "body": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"], "$description": "Quiet UI text: explanations, meta, inputs. Weights 400/500/600." }
  },
  "type": {
    "display":  { "family": "hand", "weight": 700, "size": 56, "lineHeight": 1.0,  "use": "One per screen: the screen's sentence (\"nothing left this phone.\")" },
    "headline": { "family": "hand", "weight": 700, "size": 40, "lineHeight": 1.05, "use": "Screen titles (\"talks\", \"people\")" },
    "title":    { "family": "hand", "weight": 700, "size": 30, "lineHeight": 1.1,  "use": "Doors on Today, section heads (\"who was there\")" },
    "door":     { "family": "hand", "weight": 600, "size": 26, "lineHeight": 1.15, "use": "List rows, toggles, findings" },
    "hand":     { "family": "hand", "weight": 600, "size": 20, "lineHeight": 1.2,  "use": "Buttons, links, nav words, small labels" },
    "body":     { "family": "body", "weight": 400, "size": 15, "lineHeight": 1.45, "use": "Explanations" },
    "meta":     { "family": "body", "weight": 400, "size": 13, "lineHeight": 1.4,  "color": "pencil", "use": "Dates, sizes, counts" },
    "mono":     { "family": "monospace", "weight": 400, "size": 12, "use": "Placeholders like [NAME_1], timestamps" }
  },
  "space": { "xs": 4, "s": 8, "m": 16, "l": 24, "xl": 40, "xxl": 64, "gutter": 24, "maxColumn": 560 },
  "radius": { "pill": 999, "snapshot": 2, "well": 14 },
  "stroke": { "hairline": 1.2, "doodle": 2.2, "bold": 3.0, "cap": "round", "join": "round" },
  "motion": {
    "ease": "cubic-bezier(0.16, 1, 0.3, 1)",
    "quick": 150,
    "base": 250,
    "draw": 600,
    "note": "Doodles draw themselves in (stroke reveal) once; nothing loops except the recording circle. Respect reduced motion."
  },
  "elevation": { "none": 0, "snapshot": 2, "note": "No shadows except a 2dp lift under photo snapshots." },
  "doodles": ["arrow", "back", "lock", "lock-open", "tick", "cross", "star", "circle", "underline", "mic", "play", "pause", "eye", "squiggle", "exclaim"]
}
