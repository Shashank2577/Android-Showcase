{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Burrow · Hand-drawn Minimal",
  "version": "2.0.0",
  "color": {
    "paper": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Page background. No cards: content sits straight on the paper."
    },
    "ink": {
      "$type": "color",
      "$value": "#1A1A1A",
      "$description": "Text, doodles, the ink button. Sentences are ink. 17.4:1 on paper."
    },
    "pencil": {
      "$type": "color",
      "$value": "#555555",
      "$description": "Meta lines, at most two lines. 7.5:1 on paper, 6.7:1 on smudge."
    },
    "graphite": {
      "$type": "color",
      "$value": "#6B6B6B",
      "$description": "Placeholders and disabled things only. Nothing that informs. 5.3:1 on paper, 4.8:1 on smudge."
    },
    "rule": {
      "$type": "color",
      "$value": "#1A1A1A33",
      "$description": "Sketchy hairline dividers (ink at 20%). Decoration, never the only edge of a control."
    },
    "smudge": {
      "$type": "color",
      "$value": "#F4F3EF",
      "$description": "The only fill: input wells, photo placeholders, the mask box."
    },
    "marker": {
      "$type": "color",
      "$value": "#FFE45C",
      "$description": "One swipe per screen, behind a fact: a number or a word or two, at most 16 characters."
    },
    "markerInk": {
      "$type": "color",
      "$value": "#1A1A1A",
      "$description": "Text on marker; always ink, in both themes."
    },
    "redPen": {
      "$type": "color",
      "$value": "#C81E1E",
      "$description": "Destructive actions and the ! mark, never a paragraph. 5.7:1 on paper, 5.2:1 on smudge."
    },
    "dark": {
      "paper": {
        "$type": "color",
        "$value": "#1E1D1B",
        "$description": "Warm charcoal, not black: thin hand strokes don't bloom."
      },
      "ink": {
        "$type": "color",
        "$value": "#E8E3D8",
        "$description": "Chalky ink, 13.2:1 on paper."
      },
      "pencil": {
        "$type": "color",
        "$value": "#B9B3A8"
      },
      "graphite": {
        "$type": "color",
        "$value": "#A39D92",
        "$description": "6.3:1 on paper, 5.2:1 on smudge."
      },
      "rule": {
        "$type": "color",
        "$value": "#E8E3D859"
      },
      "smudge": {
        "$type": "color",
        "$value": "#2D2B28",
        "$description": "Wells that are actually visible."
      },
      "marker": {
        "$type": "color",
        "$value": "#D9BF45",
        "$description": "Toned down so a highlight glows instead of shouting."
      },
      "markerInk": {
        "$type": "color",
        "$value": "#1E1D1B"
      },
      "redPen": {
        "$type": "color",
        "$value": "#FF8A80"
      }
    },
    "series": {
      "$type": "color",
      "$value": [
        "#1A1A1A",
        "#8A6D1F",
        "#3E6B5A",
        "#7A4A6B",
        "#4A5E85",
        "#9A4B3C",
        "#5F6B2E",
        "#6B6B6B"
      ],
      "$description": "Speaker dots and charts, light."
    },
    "seriesDark": {
      "$type": "color",
      "$value": [
        "#E8E3D8",
        "#BD9834",
        "#6EA691",
        "#B890AC",
        "#8E9DBC",
        "#C98E82",
        "#92A34D",
        "#9B9B9B"
      ],
      "$description": "Speaker dots and charts, dark; each at least 6:1 on dark paper."
    }
  },
  "font": {
    "hand": {
      "$type": "fontFamily",
      "$value": [
        "Caveat",
        "cursive"
      ],
      "$description": "The app's own short words only: wordmark, page titles, section heads, places, buttons, links, nav. Never under 24 sp, never data or user content."
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Nunito",
        "Inter",
        "Shantell Sans"
      ],
      "$description": "Everything you read. Chosen in Settings → handwriting; default Nunito (\"friendly\"). Weights 400 and 600."
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "monospace",
        "Roboto Mono",
        "DejaVu Sans Mono"
      ],
      "$description": "Placeholders like [NAME_1], tool calls, logs."
    }
  },
  "type": {
    "display": {
      "family": "hand",
      "weight": 700,
      "size": 52,
      "lineHeight": 58,
      "use": "Wordmark, welcome statement, record timer"
    },
    "headline": {
      "family": "hand",
      "weight": 700,
      "size": 38,
      "lineHeight": 42,
      "use": "Page titles (\"talks\", \"people\")"
    },
    "title": {
      "family": "hand",
      "weight": 700,
      "size": 30,
      "lineHeight": 34,
      "use": "Section heads, sheet titles, empty states"
    },
    "door": {
      "family": "hand",
      "weight": 600,
      "size": 24,
      "lineHeight": 28,
      "use": "Rows that lead to a place in the app, switch titles"
    },
    "label": {
      "family": "hand",
      "weight": 600,
      "size": 24,
      "lineHeight": 28,
      "use": "Buttons, links, nav words, choice pills"
    },
    "contentTitle": {
      "family": "body",
      "weight": 600,
      "size": 22,
      "lineHeight": 28,
      "use": "A talk or person on its own page"
    },
    "reading": {
      "family": "body",
      "weight": 400,
      "size": 17,
      "lineHeight": 26,
      "use": "Summaries, transcripts, answers"
    },
    "rowTitle": {
      "family": "body",
      "weight": 600,
      "size": 17,
      "lineHeight": 24,
      "use": "Title of a content row: a talk, person, model, file"
    },
    "body": {
      "family": "body",
      "weight": 400,
      "size": 16,
      "lineHeight": 24,
      "use": "Sentences, intros, field text, to-dos"
    },
    "meta": {
      "family": "body",
      "weight": 400,
      "size": 14,
      "lineHeight": 20,
      "color": "pencil",
      "use": "Second line of a row, notes under a head"
    },
    "caption": {
      "family": "body",
      "weight": 400,
      "size": 13,
      "lineHeight": 18,
      "color": "pencil",
      "use": "Timestamps, counts, sizes"
    },
    "tag": {
      "family": "body",
      "weight": 600,
      "size": 13,
      "lineHeight": 18,
      "use": "Tags, step numbers, badges"
    },
    "mono": {
      "family": "mono",
      "weight": 400,
      "size": 13,
      "lineHeight": 20,
      "use": "Placeholders like [NAME_1], tool calls, logs"
    }
  },
  "space": {
    "xs": 4,
    "s": 8,
    "sm": 12,
    "m": 16,
    "l": 24,
    "xl": 40,
    "xxl": 64,
    "gutter": 24,
    "maxColumn": 560,
    "readingColumn": 600,
    "listPane": 360,
    "twoPaneBreakpoint": 840
  },
  "radius": {
    "pill": 999,
    "snapshot": 2,
    "well": 14
  },
  "stroke": {
    "hairline": 1.2,
    "doodle": 2.2,
    "bold": 3.0,
    "cap": "round",
    "join": "round"
  },
  "motion": {
    "ease": "cubic-bezier(0.16, 1, 0.3, 1)",
    "quick": 150,
    "base": 250,
    "draw": 600,
    "note": "Doodles draw themselves in (stroke reveal) once; nothing loops except the recording circle. Respect reduced motion."
  },
  "elevation": {
    "none": 0,
    "snapshot": 2,
    "note": "No shadows except a 2dp lift under photo snapshots."
  },
  "doodles": [
    "arrow",
    "back",
    "bubble",
    "camera",
    "circle",
    "cloud-off",
    "cross",
    "curl",
    "exclaim",
    "eye",
    "eye-off",
    "gear",
    "heart",
    "lock",
    "lock-open",
    "mask",
    "mic",
    "moon",
    "pause",
    "pen",
    "people",
    "person",
    "phone",
    "play",
    "plus",
    "search",
    "share",
    "spark",
    "squiggle",
    "star",
    "stop",
    "sun",
    "tick",
    "trash",
    "underline",
    "wave"
  ],
  "voices": [
    {
      "id": "FRIENDLY",
      "label": "friendly",
      "font": "Nunito",
      "default": true
    },
    {
      "id": "FORMAL",
      "label": "formal",
      "font": "Inter"
    },
    {
      "id": "NEAT",
      "label": "neat hand",
      "font": "Shantell Sans",
      "axes": {
        "INFM": 0
      }
    }
  ],
  "size": {
    "minTap": 48,
    "minText": 13,
    "minHand": 24,
    "inkButton": 56,
    "pill": 48,
    "field": 52,
    "icon": 24,
    "iconSmall": 20,
    "row": 56
  }
}
